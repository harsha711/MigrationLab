From 7ed1da7fdaae07951a33d2d7e6e7c8013def420a Mon Sep 17 00:00:00 2001
From: migproto <migproto@local>
Date: Sat, 17 Oct 2026 19:33:38 -0400
Subject: [PATCH] EXPERIMENT (manual, not upstream): add language code tlh
 (readers-first)

---
 .../migrations/0107_user_language_code_tlh.py   | 17 +++++++++++++++++
 saleor/graphql/account/mutations/base.py        | 10 ++++++++++
 saleor/settings.py                              |  2 +-
 3 files changed, 28 insertions(+), 1 deletion(-)
 create mode 100644 saleor/account/migrations/0107_user_language_code_tlh.py

diff --git a/saleor/account/migrations/0107_user_language_code_tlh.py b/saleor/account/migrations/0107_user_language_code_tlh.py
new file mode 100644
index 0000000..d043932
--- /dev/null
+++ b/saleor/account/migrations/0107_user_language_code_tlh.py
@@ -0,0 +1,17 @@
+# EXPERIMENT (manual, not upstream): add language code tlh (readers-first)
+
+from django.db import migrations, models
+from django.conf import settings
+
+
+class Migration(migrations.Migration):
+    dependencies = [
+        ("account", "0106_merge_20260807_0748"),
+    ]
+
+    operations = [
+        migrations.AlterField(
+            model_name="user", name="language_code",
+            field=models.CharField(choices=settings.LANGUAGES, default=settings.LANGUAGE_CODE, max_length=35),
+        ),
+    ]
diff --git a/saleor/graphql/account/mutations/base.py b/saleor/graphql/account/mutations/base.py
index a3ddc3c..68b6625 100644
--- a/saleor/graphql/account/mutations/base.py
+++ b/saleor/graphql/account/mutations/base.py
@@ -303,6 +303,16 @@ class BaseCustomerCreate(DeprecatedModelMutation, I18nMixin):
         billing_address_data = data.pop(BILLING_ADDRESS_FIELD, None)
         customer_type_id = data.pop("customer_type", None)
         cleaned_input = super().clean_input(info, instance, data, **kwargs)
+        if cleaned_input.get("language_code") == "tlh":
+            # EXPERIMENT (manual): readers first; tlh is readable but not writable yet.
+            raise ValidationError(
+                {
+                    "language_code": ValidationError(
+                        "Language tlh can be read but not written yet.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
 
         if customer_type_id:
             cleaned_input["customer_type"] = cls.get_node_or_error(
diff --git a/saleor/settings.py b/saleor/settings.py
index 42ba1a0..fdc1794 100644
--- a/saleor/settings.py
+++ b/saleor/settings.py
@@ -156,7 +156,7 @@ DEFAULT_AUTO_FIELD = "django.db.models.AutoField"
 
 TIME_ZONE = "UTC"
 LANGUAGE_CODE = "en"
-LANGUAGES: list[tuple[str, str]] = CORE_LANGUAGES
+LANGUAGES: list[tuple[str, str]] = [*CORE_LANGUAGES, ("tlh", "Klingon")]
 LOCALE_PATHS = [os.path.join(PROJECT_ROOT, "locale")]
 USE_I18N = True
 USE_TZ = True
-- 
