Subject: [PATCH] EXPERIMENT (manual, not upstream): add User.customer_note and
 MOVE notes into it (no reverse)

---
 saleor/account/migrations/0107_move_note.py | 22 +++++++++++++++++++++
 saleor/account/models.py                    |  1 +
 2 files changed, 23 insertions(+)
 create mode 100644 saleor/account/migrations/0107_move_note.py

diff --git a/saleor/account/migrations/0107_move_note.py b/saleor/account/migrations/0107_move_note.py
new file mode 100644
index 0000000..cb4f0ba
--- /dev/null
+++ b/saleor/account/migrations/0107_move_note.py
@@ -0,0 +1,22 @@
+# EXPERIMENT (manual, not upstream): add User.customer_note and MOVE notes into it (no reverse)
+
+from django.db import migrations, models
+
+
+def move_notes(apps, schema_editor):
+    User = apps.get_model("account", "User")
+    User.objects.update(customer_note=models.F("note"), note=None)
+
+
+class Migration(migrations.Migration):
+    dependencies = [
+        ("account", "0106_merge_20260807_0748"),
+    ]
+
+    operations = [
+        migrations.AddField(
+            model_name="user", name="customer_note",
+            field=models.TextField(blank=True, null=True),
+        ),
+        migrations.RunPython(move_notes),
+    ]
diff --git a/saleor/account/models.py b/saleor/account/models.py
index 79da5bd..86740b8 100644
--- a/saleor/account/models.py
+++ b/saleor/account/models.py
@@ -180,6 +180,7 @@ class User(
     is_confirmed = models.BooleanField(default=True)
     last_confirm_email_request = models.DateTimeField(null=True, blank=True)
     note = models.TextField(null=True, blank=True)
+    customer_note = models.TextField(null=True, blank=True)
     date_joined = models.DateTimeField(default=timezone.now, editable=False)
     updated_at = models.DateTimeField(auto_now=True, db_index=True)
     last_password_reset_request = models.DateTimeField(null=True, blank=True)
