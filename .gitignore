pgdata/
*.sqlite
*.sqlite3
*.db
*.dump

# Raw execution runs (sanitized fixtures live in examples/)
runs/

# Large generated artifacts
*.log
*.tar
*.tar.gz
*.zip
migproto.lock
demo/runs/
