# Copy to .env (git-ignored) and load with: set -a; source .env; set +a
# migproto reads these from the process environment; it does not auto-load .env.

# OpenAI-compatible chat completions endpoint for `migproto agent-loop --proposals llm`
MIGPROTO_LLM_BASE_URL=http://localhost:8000/v1
MIGPROTO_LLM_MODEL=<model-id>
MIGPROTO_LLM_API_KEY=<api-key-or-unused>
MIGPROTO_LLM_TEMPERATURE=1.0
MIGPROTO_LLM_TOP_P=0.95
MIGPROTO_LLM_REASONING=true
MIGPROTO_LLM_THINKING_BUDGET=<tokens-per-call-or-unset>
MIGPROTO_LLM_FORCE_NONEMPTY=true
MIGPROTO_LLM_REVISION=<checkpoint-revision>
MIGPROTO_LLM_TIMEOUT=600
MIGPROTO_SERVING_BACKEND=vllm
MIGPROTO_SERVING_VERSION=<vllm-version-or-image-digest>
MIGPROTO_SERVING_FLAGS=<exact-command-flags>
MIGPROTO_SERVING_HARDWARE=<gpu-model>
MIGPROTO_SERVING_DRIVER=<driver-version>
MIGPROTO_SERVING_CUDA=<cuda-version>
MIGPROTO_BREV_INSTANCE=<instance-type>
MIGPROTO_PREFIX_CACHING=true
MIGPROTO_REASONING_PARSER=nemotron_v3
